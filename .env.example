# ---- TELEGRAM ----
# @BotFather dan olingan token (MAJURIY)
BOT_TOKEN=8581551562:AAEL1o3ZAkprv0rvO3bDRSLlDRh1OwzbRlk
# ---- AI (standart: Google Gemini BEPUL tarif) ----
# Kalitni https://aistudio.google.com/apikey dan BEPUL oling
AI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# OpenAI'ga o'tkazmoqchi bo'lsangiz (sk-... kalit kerak):
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- INFRA ----
# Render.com PORT ni avtomatik beradi — Render'da uni QO'SHMASLIK kerak.
PORT=8080

# ---- HIMOYA VA XOTIRA (ixtiyoriy, default qiymatlar ishlaydi) ----
# FLOOD_LIMIT_MESSAGES=5      # Bitta foydalanuvchi limiti (xabar soni)
# FLOOD_LIMIT_SECONDS=60      # ... shu vaqt oralig'ida (soniya)
# HISTORY_MAX_MESSAGES=12     # Har suhbat uchun eslab qolinadigan xabarlar
# AI_TIMEOUT_SECONDS=30       # AI javobini kutish muddati
