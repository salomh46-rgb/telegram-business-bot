# =========================================================
#  .env.example — namuna. Haqiqiy fayl .env bo'lib,
#  u .gitignore orqali GitHub'ga tushmaydi.
# =========================================================

# @BotFather dan olingan token (MAJURIY)
BOT_TOKEN=8581551562:AAEL1o3ZAkprv0rvO3bDRSLlDRh1OwzbRlk

# Port. Render.com PORT ni avtomatik beradi — Render'da
# uni qo'lda YOZMASLIK kerak. Lokal uchun 8080 qoldiring.
PORT=8080

# Anti-spam: bitta foydalanuvchiga ikki avto-javob orasidagi
# minimal vaqt (soniyada). 21600 = 6 soat. 0 = har xabarga javob.
REPLY_COOLDOWN_SECONDS=21600

# Avto-javob matni — FAQAT BIR QATORDA yozing!
# (ko'p qatorli qiymat .env parserida xato beradi; HTML teglari ruxsat)
AUTO_REPLY_TEXT=👋 <b>Assalomu alaykum!</b> Xabaringiz qabul qilindi ✅ Tez orada mutaxassis siz bilan bog'lanadi.
